  <!-- ── DIMENSIONS ── -->
  <column datatype='string'  name='[Issue Key]'   role='dimension' type='nominal' />
  <column datatype='string'  name='[Project]'     role='dimension' type='nominal' />
  <column datatype='string'  name='[Issue Type]'  role='dimension' type='nominal' />
  <column datatype='string'  name='[Summary]'     role='dimension' type='nominal' />
  <column datatype='string'  name='[Status]'      role='dimension' type='nominal' />
  <column datatype='string'  name='[Priority]'    role='dimension' type='nominal' />
  <column datatype='string'  name='[Assignee]'    role='dimension' type='nominal' />
  <column datatype='string'  name='[Reporter]'    role='dimension' type='nominal' />
  <column datatype='string'  name='[Team]'        role='dimension' type='nominal' />
  <column datatype='string'  name='[Sprint]'      role='dimension' type='nominal' />
  <column datatype='string'  name='[Epic]'        role='dimension' type='nominal' />
  <column datatype='string'  name='[Resolution]'  role='dimension' type='nominal' />
  <column datatype='string'  name='[Component]'   role='dimension' type='nominal' />
  <column datatype='string'  name='[Environment]' role='dimension' type='nominal' />
  <column datatype='string'  name='[Labels]'      role='dimension' type='nominal' />
  <column datatype='date'    name='[Created Date]'  role='dimension' type='ordinal' />
  <column datatype='date'    name='[Updated Date]'  role='dimension' type='ordinal' />
  <column datatype='date'    name='[Resolved Date]' role='dimension' type='ordinal' />
  <column datatype='date'    name='[Due Date]'      role='dimension' type='ordinal' />

  <!-- ── MEASURES ── -->
  <column datatype='integer' name='[Story Points]'            role='measure' type='quantitative' default-format='d' />
  <column datatype='integer' name='[Original Estimate (hrs)]' role='measure' type='quantitative' default-format='d' />
  <column datatype='integer' name='[Time Spent (hrs)]'        role='measure' type='quantitative' default-format='d' />
  <column datatype='integer' name='[Cycle Time (days)]'       role='measure' type='quantitative' default-format='d' />

  <!-- ── CALCULATED FIELDS ── -->

  <column caption='Is Overdue' datatype='string' name='[Is Overdue]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IF [Status] != &quot;Done&quot; AND [Due Date] &lt; TODAY() THEN &quot;Overdue&quot; ELSE &quot;On Track&quot; END' />
  </column>

  <column caption='Sprint Number' datatype='integer' name='[Sprint Number]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='INT(RIGHT([Sprint], 1))' />
  </column>

  <column caption='Priority Rank' datatype='integer' name='[Priority Rank]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='CASE [Priority] WHEN &quot;Highest&quot; THEN 1 WHEN &quot;High&quot; THEN 2 WHEN &quot;Medium&quot; THEN 3 WHEN &quot;Low&quot; THEN 4 WHEN &quot;Lowest&quot; THEN 5 END' />
  </column>

  <column caption='Remaining Hours' datatype='integer' name='[Remaining Hours]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN([Original Estimate (hrs)]) - ZN([Time Spent (hrs)])' />
  </column>

  <column caption='% Time Used' datatype='real' name='[Pct Time Used]' role='measure' type='quantitative' default-format='p0%'>
    <calculation class='tableau' formula='IF ZN([Original Estimate (hrs)]) &gt; 0 THEN ZN([Time Spent (hrs)]) / [Original Estimate (hrs)] END' />
  </column>

  <column caption='Is Blocked' datatype='integer' name='[Is Blocked]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Status] = &quot;Blocked&quot; THEN 1 ELSE 0 END' />
  </column>

  <column caption='Is Done' datatype='integer' name='[Is Done]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [Status] = &quot;Done&quot; THEN 1 ELSE 0 END' />
  </column>

  <column caption='Completion Rate' datatype='real' name='[Completion Rate]' role='measure' type='quantitative' default-format='p0%'>
    <calculation class='tableau' formula='SUM([Is Done]) / COUNT([Issue Key])' />
  </column>

  <column caption='Avg Cycle Time (days)' datatype='real' name='[Avg Cycle Time]' role='measure' type='quantitative' default-format='0.0'>
    <calculation class='tableau' formula='AVG(IF [Cycle Time (days)] &gt; 0 THEN [Cycle Time (days)] END)' />
  </column>

  <column caption='Workload Score' datatype='integer' name='[Workload Score]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='ZN([Story Points]) + ZN([Original Estimate (hrs)])' />
  </column>

</datasource>
